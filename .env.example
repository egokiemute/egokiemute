# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Absolute base URL, no trailing slash. Falls back to https://okiemute.cv.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Sanity (powers the existing /writings section — unrelated to /blog)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# ---------------------------------------------------------------------------
# Cloudinary (post images for /blog)
# ---------------------------------------------------------------------------
# Public: used by the client-side <CloudinaryImage> loader. REQUIRED for images.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# Server-only credentials (not currently used by the app; kept for tooling).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------------------------------------------------------------------------
# MongoDB (comments + likes for /blog ONLY)
# ---------------------------------------------------------------------------
# If unset or unreachable, likes/comments degrade to a disabled state and blog
# posts still render. Run `npm run ensure-indexes` once after setting this.
MONGODB_URI=

# ---------------------------------------------------------------------------
# Comment rate limiting + moderation
# ---------------------------------------------------------------------------
# Salt for the SHA-256 hash of commenter IPs. Raw IPs are never stored.
IP_HASH_SALT=
# Secret in the moderation links logged/emailed on each new comment.
# Compared with a timing-safe check. Use a long random string.
MODERATION_SECRET=

# ---------------------------------------------------------------------------
# Moderation notifications (optional)
# ---------------------------------------------------------------------------
# If both are set, new-comment moderation links are emailed via the Resend REST
# API instead of only being logged to the server console.
RESEND_API_KEY=
MODERATION_NOTIFY_EMAIL=
